{
  "name": "@deepseek-ai/dsh-orchestrator",
  "description": "Tenant runtime manager for the multi-tenant platform: on-demand ACP child spawn, idle reaping, concurrency cap with queueing, and crash-safe reacquire",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
