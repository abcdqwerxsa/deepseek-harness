    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "execa": "^10.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-mock-server": "workspace:^",
    "@deepseek-ai/dsh-tenant-profile": "workspace:^"
  },
  "license": "MIT"
}
