{
  "name": "@deepseek-ai/dsh-platform-bff",
  "description": "Thin BFF for the multi-tenant platform: bearer-token tenant auth, ACP REST passthrough over the orchestrator, WebSocket update fan-out with forwarded permission approval, and a SQLite transcript store",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "portal"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-orchestrator": "workspace:^",
    "@deepseek-ai/dsh-tenant-profile": "workspace:^",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-mock-server": "workspace:^",
    "@types/ws": "^8.18.1",
    "jsdom": "29.1.1"
  },
  "license": "MIT"
}
