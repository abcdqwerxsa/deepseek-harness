# Required: tenant tokens as a JSON array of [token, tenantId] pairs.
PLATFORM_TOKENS=[["change-me-token-alpha","alpha"],["change-me-token-beta","beta"]]

# Required: the platform-held model key injected into tenant children at spawn.
DEEPSEEK_API_KEY=

# Optional: provider base URL override.
#DEEPSEEK_BASE_URL=

# Optional: settings.yaml content written into every tenant home (adapter
# overrides; e.g. 'llm-deepseek:\n  protocol: chat-completions' for a
# chat-completions-compatible provider).
#PLATFORM_SETTINGS_YAML=

# Version-lock stamp recorded in every tenant manifest; bump on platform upgrades.
PLATFORM_DSH_VERSION=0.0.0-compose

# Optional: per-tenant isolation wrapper argv (JSON). Example bwrap line for
# this image's layout — a private user/PID namespace, read-only system and
# app trees, writable tenants data only:
#PLATFORM_ISOLATION=["bwrap","--unshare-user","--unshare-pid","--die-with-parent","--ro-bind","/usr","/usr","--ro-bind","/etc","/etc","--ro-bind","/app","/app","--symlink","usr/lib64","/lib64","--symlink","usr/lib","/lib","--symlink","usr/bin","/bin","--symlink","usr/sbin","/sbin","--dir","/data/tenants","--bind","{tenantDir}","{tenantDir}","--dev","/dev","--tmpfs","/tmp"]

# DEEPSEEK_BASE_URL pointing at a host service needs host-gateway reachability
# (the compose service already adds host.docker.internal:host-gateway).

# Optional: orchestrator sizing.
#PLATFORM_MAX_CONCURRENT=8

# Model gateway (recommended): the provider key stays in the platform process;
# tenant children hold short-lived signed tokens for the internal endpoint.
# Requires the chat-completions PLATFORM_SETTINGS_YAML and a fixed port.
#PLATFORM_MODEL_GATEWAY=1
#PLATFORM_MODEL_GATEWAY_SECRET=change-me-random-hex

# Optional: re-provision over version-locked tenant manifests during a
# platform upgrade (one deployment; see README before setting).
#PLATFORM_FORCE_REPROVISION=true

# Host port the TLS gateway publishes.
GATEWAY_PORT=8443
