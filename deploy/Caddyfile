# Internal-network TLS termination with Caddy's built-in CA; point tenants at
# https://<host>:8443 (the browser trusts the internal CA once imported from
# the caddy-data volume, or bring your own cert pair and replace the
# `tls internal` block). On-demand issuance covers IP and ad-hoc names used
# on an intranet without a fixed hostname.
{
  admin off
}

:443 {
  tls internal {
    on_demand
  }
  encode zstd gzip
  request_body {
    max_size 8MB
  }
  # WebSocket upgrades pass through reverse_proxy transparently.
  reverse_proxy platform:8080
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
}
